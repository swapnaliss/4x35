# Copy to .env and fill. Never commit .env. Key names only here.
NODE_ENV=
MODE=                      # web | worker | all
PORT=
DATABASE_URL=
SESSION_SECRET=
CSRF_SECRET=
APP_BASE_URL=
LOG_LEVEL=
# Optional LLM step (opt-in per workspace)
ANTHROPIC_API_KEY=
LLM_PROVIDER=              # anthropic | bedrock
LLM_MODEL=                 # claude-haiku-5-5
LLM_DAILY_SPEND_CAP_USD=
LLM_BATCH_TOKEN_CAP=
AWS_REGION=                # only if LLM_PROVIDER=bedrock (eu-central-1)
# Deploy
RENDER_API_KEY=            # local CLI / CI deploy only
# Bootstrap admin (first owner invite)
BOOTSTRAP_ADMIN_EMAIL=
# AWS credentials for the Bedrock probe come from the standard SDK chain; name the profile only
AWS_PROFILE=
# End-to-end tests against production (a dedicated synthetic e2e user; owner creates its invite)
E2E_BASE_URL=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
