{
  "name": "4x35",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "integrations/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --config vitest.workspace.ts",
    "test:unit": "vitest run --config vitest.workspace.ts --exclude '**/*.prop.test.ts'",
    "test:prop": "vitest run --config vitest.workspace.ts .prop.test.ts",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
