{
  "name": "@4x35/server",
  "version": "0.1.0",
  "private": true,
  "description": "Hono API and worker (MODE=web|worker|all).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run",
    "start": "node dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "jobs:dead-letters": "tsc -b && node scripts/dead-letters.ts",
    "bootstrap:admin": "tsc -b && node scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@4x35/core": "0.1.0",
    "@4x35/db": "0.1.0",
    "@hono/node-server": "2.1.8",
    "@hono/zod-openapi": "1.6.3",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
