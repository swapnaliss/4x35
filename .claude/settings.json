{
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(render deploys create *)",
      "Bash(render deploys list *)",
      "Bash(npm run sandbox:reset *)",
      "Bash(npm run sandbox:status *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.production)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(grep * .env)",
      "Bash(source .env)",
      "Bash(printenv)",
      "Bash(env)"
    ]
  }
}
